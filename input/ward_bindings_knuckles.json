{
  "name": "Ward panel bindings",
  "description": "Point at Ward's panel and squeeze the grip to take hold of it.",
  "controller_type": "knuckles",
  "bindings": {
    "/actions/panel": {
      "sources": [
        {
          "path": "/user/hand/left/input/grip",
          "mode": "force",
          "inputs": {
            "force": {
              "output": "/actions/panel/in/grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "force",
          "inputs": {
            "force": {
              "output": "/actions/panel/in/grab"
            }
          }
        }
      ],
      "poses": [
        {
          "output": "/actions/panel/in/hand",
          "path": "/user/hand/left/pose/raw"
        },
        {
          "output": "/actions/panel/in/hand",
          "path": "/user/hand/right/pose/raw"
        }
      ]
    }
  }
}
