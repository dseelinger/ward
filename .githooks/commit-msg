#!/usr/bin/env sh
#
# Rejects a commit message containing a banned word.
#
# check.sh cannot see this surface, because a commit message is not a file.
# Same two lists, same rule: never echo a list, report matches only.
#
# Enable with:  git config core.hooksPath .githooks

set -u

msg="$1"

repo_root=$(git rev-parse --show-toplevel) || exit 1

SHARED="$repo_root/check/banned-words.txt"
LOCAL="${WARD_BANNED_WORDS:-$repo_root/.local/banned-words.txt}"

status=0

# Drop git's own comment lines, and everything below the `git commit -v`
# scissors marker — otherwise the diff being committed gets scanned as though
# it were the message, and reports the same hit twice.
body=$(sed -e '/^# -* >8 -*$/,$d' -e '/^#/d' "$msg")

# See check.sh: the lists allow comments and blank lines, and a blank line in a
# `grep -f` file matches everything.
load_patterns() {
    sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$1" | paste -sd '|' -
}

check_list() {
    list="$1"

    if [ ! -f "$list" ]; then
        echo "commit-msg: no word list at $list — refusing to check nothing" >&2
        return 1
    fi

    pattern=$(load_patterns "$list")

    if [ -z "$pattern" ]; then
        echo "commit-msg: the word list at $list has no patterns" >&2
        return 1
    fi

    hits=$(printf '%s\n' "$body" | grep -I -n -i -E -e "$pattern" -- 2>/dev/null)

    if [ -n "$hits" ]; then
        printf '%s\n' "$hits" | sed 's/^/  /' >&2
        echo "commit-msg: banned word in commit message" >&2
        return 1
    fi

    return 0
}

check_list "$SHARED" || status=1
check_list "$LOCAL" || status=1

exit "$status"
